        *(.text.HW_RenderBSPNode.isra.4.constprop.5)
        *(.text.HW_UpdatePortalWordCols)
        *(.text.HW_EmitMultiBandBakedWall.constprop.17)
        *(.text.HW_RenderSubsectorSprites.isra.2)
        *(.text.HW_EmitWallStrips_Linear.constprop.18)
        *(.text.HW_RecordSegPortalAperture.constprop.26)
        *(.text.HW_EmitSubdividedBakedSeg.constprop.14)
        *(.text.HW_CacheFlatSectorInfo)
        *(.text.HW_EmitWallFromCtx.isra.3.constprop.9)
        *(.text.v1_tex_get)
        *(.text.HW_BuildSectorThings.isra.0)
        *(.text.HW_CommitSubSolidMask)
        *(.text.HW_CheckBBoxStatus)
        *(.text.HW_UpdatePortalWordPartial)
        *(.text.P_MobjThinker)
        *(.text.HW_CommitPortalSpan)
        *(.text.P_GetSightMobj)
        *(.text.Saturn_Vdp1_GetFlatSrcaVariant)
        *(.text.HW_IsSpanOccluded)
        *(.text.HW_RecordSubsectorUnbakedPortals.constprop.24)
        *(.text.Saturn_Vdp1_FlatAvgColor)
        *(.text.P_RunMobjBase2)
        *(.text.P_RunMobjLate)
        *(.text.HW_MarkSubSolidSpan)
        *(.text.HW_TransformPillar_Shifted)
        *(.text.HW_RenderSubsector)
        *(.text.HW_LoadWallTexCtx.constprop.10)
        *(.text.HW_EmitWallStrips_Persp_General.constprop.21)
        *(.text.HW_CullBSPBBox)
        *(.text.Saturn_SpritePatch)
        *(.text.HW_RecordPortalSpan)
        *(.text.HW_SubsectorHasThings.isra.1)
        *(.text.jo_get_inputs_vblank)
        *(.text.Saturn_Vdp1Spr_Add)
        *(.text.Saturn_HUD_Draw)
        *(.text.HW_EvalSubsectorSpanSlow)
        *(.text.v1_tags_try_alloc)
        *(.text.HW_CommitSubsectorOcclusion)
        *(.text.PS_CrossBSPNode)
        *(.text.Saturn_CmdBuf_ComputeDDA)
        *(.text.hud_tiny)
        *(.text.HW_EmitStripQuad_Slow)
        *(.text.jo_smpc_handler)
        *(.text.HW_ProjectPortalEndpoint)
        *(.text.P_SetMobjState)
        *(.text.P_PlayerThink)
        *(.text.HW_IsStripOccluded_Slow)
        *(.text.HW_FlatAltPack)
        *(.text.Saturn_ProfSpan)
        *(.text.HW_ExtrapolateMonoWallX.constprop.16)
        *(.text.D_DoomLoop)
        *(.text.jo_smpc_parse_port)
        *(.text.HW_RenderPlayerWeapon)
        *(.text.jo_core_vblank_in_handler)
        *(.text.P_CalcHeight)
        *(.text.P_UpdateSpecials)
        *(.text.P_BuildMove)
        *(.text.v1_vblank_callback)
        *(.text.Saturn_Vdp1Wall_Frame)
        *(.text.HW_CheckPortalSubsectorStepCull)
        *(.text.lshrsi3_r0)
        *(.text.HW_ClampedFrac)
        *(.text.I_ReadControls)
        *(.text.HW_ClipWallNearPlane.constprop.25)
