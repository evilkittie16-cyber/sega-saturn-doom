/*
** Jo Engine linker script (DOOM copy with a hot-function order)
**
** 0x06004000 - ...        : program and user data, then the engine work area (VDP1 command lists, 3D buffers...)
** ...        - 0x060FBC00 : free (given to jo_malloc(), see jo_init_memory())
** 0x060FBC00 - 0x060FFC00 : master CPU stack
*/
SECTIONS {
    JO_START 0x06004000 : {
        ___Start = .;
        *(JO_START)
    }
    .text ALIGN(0x20) :
    {
        /* DOOM: profile-ordered hot functions first (doom_hot.linker, 2026-11-15;
           regenerate with 5thPlanet tmp/doomprof/hotorder.py). Packs the
           render code the SH-2 4 KB cache keeps refetching. */
        *(.text.HW_CheckSubsectorAperture)
        *(.text.HW_RenderSubsector_Body.constprop.6)
        *(.text.Saturn_HW_RenderPlayerView)
        *(.text.HW_EmitWallStrips_Linear_General.constprop.19)
        *(.text.HW_GetSpanAperture)
        *(.text.HW_ProjectAndCullPillarPair)
        *(.text.Saturn_CmdBuf_Deliver)
        *(.text.HW_SubmitSlaveFlatJob)
        *(.text.HW_EmitVisibleBakedSeg)
        *(.text.HW_RenderSubsectorBakedWalls)
        *(.text.HW_EmitBakedWallQuads.constprop.13)
        *(.text.HW_WalkSubsectorBakedSegs)
        *(.text.HW_RescanApertureWords)
        *(.text.HW_CheckSpanOcclusion)
        *(.text.HW_EmitMonolithicBakedSeg.constprop.15)
        *(.text.HW_TransformSubsectorPillar)
