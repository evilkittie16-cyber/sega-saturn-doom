        *(.text.FixedDiv)
        *(.text.D_Display.part.3)
        *(.text.saturn_vblank_callback)
        *(.text.P_SetPsprite)
        *(.text.v1_copy_block)
        *(.text.finesine)
        *(.text.Saturn_G_Ticker)
        *(.text.P_RunThinkers)
        *(.text.jo_vdp1_vblank)
        *(.text.jo_vdp2_commit)
        *(.text.HW_EmitUserClip.constprop.27)
        *(.text.P_LookForPlayers)
        *(.text.HW_ClipSegNearPlane.constprop.8)
        *(.text.jo_smpc_vblank_in)
        *(.text.hud_tiny_num)
        *(.text.Saturn_G_Display)
        *(.text.T_Glow)
        *(.text.Saturn_CmdBuf_CullOccluded)
        *(.text.HW_Worker_ProcessJob.constprop.7)
        *(.text.HW_EmitFlatQuadBanded)
        *(.text.HW_EmitFlatBands)
        *(.text.HW_V1QuadHoleRisk)
        *(.text.HW_FlatHoleBacking)
        *(.text.sdivsi3)
        *(.text.HW_ScreenClipDepth)
        *(.text.HW_ClipFlatQuadOffscreen)
        *(.text.HW_FlatSizeLOD)
        *(.text.HW_EmitFlatQuad_Clipped)
        *(.text.HW_Slave_IsSpanOccluded)
        *(.text.HW_ClipQuadPlane)
        *(.text.ashlsi3_r0)
        *(.text.HW_SliceFlatQuadV)
        *(.text.HW_ClipCoord)
        *(.text.movstrSI16)
        *libgcc.a:*(.text)
        *(.text)
        *(.text.*)
        *(.strings)
        __etext = .;
    }
    .rodata ALIGN(0x20) :
    {
        *(.rodata)
        *(.rodata.*)
    }
    .tors ALIGN(0x10) :
    {
        ___ctors = . ;
        *(.ctors)
        ___ctors_end = . ;
        ___dtors = . ;
        *(.dtors)
        ___dtors_end = . ;
    }
    .data ALIGN(0x10) :
    {
        *(.data)
        *(.data.*)
        __edata = . ;
    }
    .bss ALIGN(0x10) (NOLOAD) :
    {
        __bstart = . ;
        *(.bss)
        *(.bss.*)
        * ( COMMON )
        . = ALIGN(4);
        __bend = . ;
        _end = .;
    }
    JO_WORK ALIGN(0x4000) (NOLOAD) :
    {
        __jo_work_start = . ;
        /* (the buffers with a big alignment first, 16 KB at most: no hole between the others; the high work RAM between
           the end of the program and this area is given to jo_malloc()) */
        *(JO_WORK_ALIGNED)
        *(SORT_BY_ALIGNMENT(JO_WORK))
        . = ALIGN(4);
        __jo_work_end = . ;
    }
    /DISCARD/ :
    {
        *(.comment)
        *(.eh_frame)
        *(.eh_frame_hdr)
    }
}
ASSERT(__jo_work_end <= 0x060FBC00, "Program too big: the program and the engine work area overlap the stack at 0x060FBC00")

